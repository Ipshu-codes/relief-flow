# Copy to .env (`make setup` does this automatically).
# Every value below is safe for offline local development.

# --- AI runtime (local Ollama; not required in Phase 0) ---
RAHAT_MODEL=qwen2.5:1.5b-instruct
RAHAT_AGENT_MODEL=qwen2.5:7b-instruct
RAHAT_EMBED_MODEL=nomic-embed-text
RAHAT_LLM_URL=http://127.0.0.1:11434
RAHAT_MOCK_LLM=true
AGENT_MODE=rules
AGENT_MAX_STEPS=6

# --- Dispatch policy ---
AUTO_DISPATCH=false
AUTO_DISPATCH_MIN_PRIORITY=85

# --- Demo Mode (virtual radio, real codec + ingest + AI) ---
DEMO_MODE=false

# --- Auth (change this in production!) ---
RAHAT_AUTH_SECRET=dev-only-insecure-secret-change-me

# --- Offline routing (GraphHopper; `make graphhopper`) ---
# Unreachable router => the gateway silently falls back to haversine.
RAHAT_ROUTER_URL=http://127.0.0.1:8989

# --- Storage ---
RAHAT_DATABASE_URL=sqlite:///./rahat.db
